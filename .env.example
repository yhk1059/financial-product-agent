# 프로젝트 루트의 .env 로 복사해서 값을 채운다. (.env 는 git에 올리지 않는다)

# PostgreSQL 읽기 전용 계정 (에이전트·테스트·스크립트 공통)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=

# knowledge 스키마 쓰기 계정 (load_ontology.py, embed_ontology.py, eval_retrieval.py 의 정답 읽기에만 필요)
KNOWLEDGE_PGUSER=
KNOWLEDGE_PGPASSWORD=

# HyperCLOVA X
CLOVA_STUDIO_API_KEY=
CLOVASTUDIO_MODEL=HCX-007

# LangSmith 추적
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
